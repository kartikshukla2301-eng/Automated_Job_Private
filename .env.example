# Placeholders only; never put real credentials in this file.

# Supabase REST API base URL, e.g. https://<project-ref>.supabase.co (Project Settings > API > Project URL).
# NOT a postgresql:// connection string — the app talks PostgREST over HTTPS, not raw libpq.
SUPABASE_URL=
# Project Settings > API > "anon public" key.
SUPABASE_ANON_KEY=
# Project Settings > API > "service_role secret" key. Backend-only; never in frontend/worker.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: raw postgresql:// connection string, only needed to run/re-run migrations directly.
SUPABASE_DB_URL=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: only needed if you run your own separate DevLeveler instance and set
# config/config.yaml -> profile.source: "devleveler". Safe to leave blank (defaults to
# fixtures/profile.yaml via LocalFileProfileSource).
DEVLEVELER_PROFILE_URL=
DEVLEVELER_READ_TOKEN=

# A secret string you make up yourself for the local worker to authenticate to this API.
# For solo local dev you can instead leave this blank and set ALLOW_TOKENLESS_DEV=true.
WORKER_TOKEN=
# Local-dev-only, loopback-only escape hatch when WORKER_TOKEN is unset. Never honored on
# non-loopback hosts or in production/staging.
ALLOW_TOKENLESS_DEV=false
